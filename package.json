{
  "name": "smart-event",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node scripts/dev-bootstrap.mjs && npm --workspace apps/api run start:dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm run build --workspace apps/api && npm run build --workspace apps/web",
    "db:up": "docker compose -f infra/docker-compose.yml up -d mysql",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:seed": "prisma db seed --schema prisma/schema.prisma",
    "db:studio": "prisma studio --schema prisma/schema.prisma"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prisma": "6.19.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "dotenv": "^16.4.7"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
