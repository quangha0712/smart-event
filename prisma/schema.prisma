generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  ORGANIZER
  ATTENDEE
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

/// Kênh nhận diện vé khi check-in.
enum CheckInMethod {
  QR
  NFC
  MANUAL
}

/// Kết quả của một lượt quét. Chỉ ACCEPTED mới ghi nhận Ticket.checkedInAt.
enum CheckInResult {
  ACCEPTED
  DUPLICATE // vé đã check-in trước đó (quét lặp)
  INVALID_CODE // không tìm thấy vé ứng với mã quét
  WRONG_EVENT // vé thuộc sự kiện khác
  NOT_ELIGIBLE // đăng ký bị huỷ hoặc chưa xác nhận
}

enum DeviceType {
  QR_SCANNER
  NFC_READER
  SENSOR
  GATEWAY
}

enum SensorType {
  TEMPERATURE
  HUMIDITY
  CO2
  NOISE
  PEOPLE_COUNT
  OTHER
}

enum AssignmentStatus {
  ASSIGNED
  CONFIRMED
  DECLINED
  COMPLETED
}

/// Nguồn tạo dòng dự toán. AI chỉ gợi ý, người phụ trách phải duyệt.
enum BudgetItemSource {
  MANUAL
  AI_SUGGESTED
}

// ---------------------------------------------------------------------------
// Người dùng & sự kiện
// ---------------------------------------------------------------------------

model User {
  id                  String           @id @default(cuid())
  email               String           @unique @db.VarChar(191)
  fullName            String           @db.VarChar(191)
  passwordHash        String           @db.VarChar(255)
  role                UserRole         @default(ATTENDEE)
  registrations       Registration[]
  feedback            EventFeedback[]
  staffProfile        StaffMember?
  operatedCheckIns    CheckInAttempt[]
  recordedExpenses    Expense[]
  approvedBudgetItems BudgetItem[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

